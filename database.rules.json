{
  "rules": {
    "presence": {
      "$roomId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['state']) && (newData.child('state').val() === 'online' || newData.child('state').val() === 'offline')"
        }
      }
    }
  }
}
