rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomExists(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId));
    }

    function roomExistsAfter(roomId) {
      return existsAfter(/databases/$(database)/documents/rooms/$(roomId));
    }

    function isRoomMember(roomId) {
      return signedIn()
        && roomExists(roomId)
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;
    }

    function isRoomMemberAfter(roomId) {
      return signedIn()
        && roomExistsAfter(roomId)
        && request.auth.uid in getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.status == 'lobby'
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.players.size() == 1;

      allow get: if signedIn()
        && (resource.data.status == 'lobby' || request.auth.uid in resource.data.memberUids);
      allow list: if false;

      allow update: if signedIn() && (
        (
          request.auth.uid in resource.data.memberUids
          && resource.data.status == 'lobby'
          && request.resource.data.status == 'playing'
          && request.auth.uid == resource.data.hostUid
        )
        || (
          request.auth.uid in resource.data.memberUids
          && resource.data.status == 'lobby'
          && request.resource.data.status == 'lobby'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'memberUids', 'players', 'hostUid'])
        )
        || (
          resource.data.status == 'lobby'
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.status == 'lobby'
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.size() <= 4
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.players.size() == resource.data.players.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'memberUids', 'players'])
        )
        || (
          request.auth.uid in resource.data.memberUids
          && resource.data.status == 'playing'
          && request.resource.data.status in ['playing', 'finished']
        )
      );

      allow delete: if signedIn()
        && request.auth.uid in resource.data.memberUids;

      match /private/{playerUid} {
        allow get: if signedIn()
          && request.auth.uid == playerUid
          && isRoomMember(roomId);
        allow list: if false;
        allow create, update: if signedIn()
          && request.auth.uid == playerUid
          && (isRoomMember(roomId) || isRoomMemberAfter(roomId));
        allow delete: if signedIn()
          && isRoomMember(roomId)
          && (
            request.auth.uid == playerUid
            || !roomExistsAfter(roomId)
          );
      }
    }

    match /roomClosures/{roomId} {
      allow get: if signedIn()
        && request.auth.uid in resource.data.memberUids;
      allow list: if false;
      allow create: if signedIn()
        && roomExists(roomId)
        && !roomExistsAfter(roomId)
        && isRoomMember(roomId)
        && request.resource.data.memberUids
          == get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids
        && request.resource.data.closedByUid == request.auth.uid
        && request.resource.data.closedByName is string;
      allow update, delete: if false;
    }
  }
}
